VPN_CONFIG=./client11.ovpn
FRAMES_DIR=./frames
# Candidate VPN gateway, NOT a confirmed robot host. Replace after discovery.
DDS_PEERS=10.8.0.1
ROS_DOMAIN_ID=0
DDS_MAX_PARTICIPANT_INDEX=32
# auto selects one published Image/CompressedImage topic (prefers compressed).
IMAGE_TOPIC=auto
# 0 = unlimited. Duration includes time waiting for discovery.
MAX_FRAMES=0
DURATION_SECONDS=0
SAVE_EVERY=1
WRITER_QUEUE_SIZE=64

# Optional graphical myCobot 280 Pi laboratory (Compose profile "lab").
LAB_WEB_PORT=6080
LAB_DOMAIN_ID=231
LAB_START_DEMO=1
LAB_SCREEN_SIZE=1600x1200
