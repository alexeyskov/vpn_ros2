# Optional: copy to .env.wg and pass --env-file .env.wg to BOTH Compose stacks.
# Existing .env (OpenVPN) is not used by these options.
WG_LISTENER_CONFIG_PATH=./wg/Client1.conf
WG_SENDER_CONFIG_PATH=./wg/Client2.conf
# Remote WG addresses: each role reads its own address from the tunnel.
WG_LISTENER_IP=10.10.0.4
WG_SENDER_IP=10.10.0.3
WG_TEST_ROS_DOMAIN_ID=42
# 0 = continuously send until stopped.
WG_TEST_COUNT=5
WG_TEST_INTERVAL=1
WG_TEST_TEXT="Привет от Client2 через WireGuard!"
WG_TEST_ACK_TIMEOUT=15
WG_TEST_DISCOVERY_TIMEOUT=60
WG_TEST_RETRIES=3
